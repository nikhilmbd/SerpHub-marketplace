generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SELLER
}

enum DomainStatus {
  AVAILABLE
  RESERVED
  SOLD
  INACTIVE
}

enum ListingType {
  OWNED
  SELLER
}

enum OrderStatus {
  PENDING
  UNDER_REVIEW
  CONTACTED
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

model User {
  id               String         @id @default(cuid())
  name             String?
  email            String         @unique
  passwordHash     String?
  role             UserRole       @default(CUSTOMER)
  emailVerifiedAt  DateTime?
  telegramUsername String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  orders           Order[]
  wishlistItems    WishlistItem[]
  offers           Offer[]
  sellerProfile    Seller?
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  domains   Domain[]
  createdAt DateTime @default(now())
}

model Domain {
  id               String         @id @default(cuid())
  name             String         @unique
  slug             String         @unique
  description      String?
  priceUSD         Decimal        @db.Decimal(12, 2)
  categoryId       String?
  category         Category?      @relation(fields: [categoryId], references: [id])
  ageYears         Decimal?       @db.Decimal(6, 2)
  authorityScore   Decimal?       @db.Decimal(6, 2)
  domainAuthority  Decimal?       @db.Decimal(6, 2)
  pageAuthority    Decimal?       @db.Decimal(6, 2)
  domainRating     Decimal?       @db.Decimal(6, 2)
  tags             String[]       @default([])
  backlinks        BigInt?
  referringDomains Int?
  organicTraffic   Int?
  metricsSource    String?
  metricsUpdatedAt DateTime?
  registrar        String?
  listingType      ListingType    @default(OWNED)
  ownerId          String?
  seller           Seller?        @relation(fields: [ownerId], references: [id])
  status           DomainStatus   @default(AVAILABLE)
  featured         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  orderItems       OrderItem[]
  wishlistItems    WishlistItem[]
  offers           Offer[]

  @@index([status, categoryId])
  @@index([priceUSD])
  @@index([domainRating])
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  customerId       String?
  customer         User?         @relation(fields: [customerId], references: [id])
  customerName     String
  customerEmail    String
  telegramUsername String?
  preferredContact String?
  currency         String        @default("USD")
  totalAmount      Decimal       @db.Decimal(14, 2)
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID)
  customerNotes    String?
  adminNotes       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            OrderItem[]

  @@index([customerEmail, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  domainId           String?
  domain             Domain? @relation(fields: [domainId], references: [id])
  domainNameSnapshot String
  unitPriceSnapshot  Decimal @db.Decimal(14, 2)
  currency           String
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, domainId])
}

model Offer {
  id        String      @id @default(cuid())
  domainId  String
  domain    Domain      @relation(fields: [domainId], references: [id])
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  name      String
  email     String
  amount    Decimal     @db.Decimal(14, 2)
  currency  String
  message   String?
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Seller {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  displayName   String
  verified      Boolean  @default(false)
  commissionPct Decimal  @default(10) @db.Decimal(5, 2)
  domains       Domain[]
  createdAt     DateTime @default(now())
}

model ImportJob {
  id           String   @id @default(cuid())
  filename     String
  totalRows    Int      @default(0)
  importedRows Int      @default(0)
  rejectedRows Int      @default(0)
  status       String   @default("PENDING")
  errorReport  Json?
  createdAt    DateTime @default(now())
}
